{
  "name": "ai-security-lab",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "description": "Central de estudos sobre segurança de IA para profissionais de AppSec, Security Champions e desenvolvedores.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/arte.mjs",
    "arte": "node scripts/arte.mjs",
    "arte:gerar": "node scripts/arte.mjs --sh > scripts/arte.sh && node scripts/arte.mjs --bat > scripts/arte.bat && chmod +x scripts/arte.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/arte.mjs",
    "preview": "vite preview",
    "prepreview": "node scripts/arte.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@rive-app/canvas": "2.44.0",
    "@rive-app/react-canvas": "^4.36.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "daisyui": "^5.7.50",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
